# Konfiguration (keine Geheimnisse – diese Datei wird committet). Geheimnisse stehen in .env.
# Modell-IDs je Rolle (ENV-überschreibbar). Knoten 4/6 = Sonnet (Kostenentscheidung, ADR-0008).
LLM_MODEL_MAIN=claude-sonnet-5
LLM_MODEL_JUDGE=claude-haiku-4-5-20251001
LLM_MODE=mock
MES_DB_PATH=data/gold/mes.sqlite
CHECKPOINT_DB_PATH=data/checkpoints.sqlite
AUDIT_LOG_PATH=data/audit.jsonl
MAX_ROWS_PER_TOOL=200
MAX_TOOL_RESULT_CHARS=8000
CONFIDENCE_THRESHOLD_RECOMMEND=0.70
LANGFUSE_HOST=http://localhost:3000
SIM_NOW=
# Claude Code (Abo-Betrieb): Modelle je Rolle
CC_MODEL_BUILDER=sonnet
CC_MODEL_REVIEWER=sonnet
CC_MODEL_DECIDER=opus
