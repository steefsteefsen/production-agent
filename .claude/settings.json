{
  "hooks": {
    "PostToolUse": [{"matcher": "Edit|Write", "hooks": [{"type": "command", "command": "ruff check --fix -q . || true"}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "pytest -q -x 2>&1 | tail -3"}]}]
  },
  "permissions": {
    "allow": [
      "Read", "Edit", "Write", "Grep", "Glob",
      "Bash(pytest:*)", "Bash(python:*)", "Bash(python3:*)", "Bash(python -m:*)",
      "Bash(python -c:*)", "Bash(python3 -c:*)", "Bash(ruff:*)",
      "Bash(bandit:*)", "Bash(pip install:*)", "Bash(pip-audit:*)", "Bash(pip show:*)", "Bash(npm:*)", "Bash(npx:*)",
      "Bash(node:*)", "Bash(uvicorn:*)", "Bash(playwright:*)", "Bash(docker compose:*)",
      "Bash(git add:*)", "Bash(git commit:*)", "Bash(git status:*)", "Bash(git diff:*)",
      "Bash(git log:*)", "Bash(git show:*)", "Bash(git tag:*)", "Bash(git worktree list:*)",
      "Bash(git -C:*)",
      "Bash(ls:*)", "Bash(cat:*)", "Bash(head:*)", "Bash(tail:*)", "Bash(grep:*)", "Bash(find:*)",
      "Bash(mkdir:*)", "Bash(cp:*)", "Bash(mv:*)", "Bash(rm -f:*)", "Bash(make:*)", "Bash(sqlite3:*)",
      "Bash(cmp:*)", "Bash(wc:*)", "Bash(cd:*)"
    ],
    "deny": ["Bash(git push:*)", "Bash(rm -rf:*)", "Bash(curl:*)", "Read(.env)", "Edit(.env)", "Edit(decisions.yaml)", "Edit(LICENSE)", "Edit(tests/acceptance/**)", "Write(tests/acceptance/**)"]
  }
}
