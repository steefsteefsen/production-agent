# Niemals die echte .env committen – steht in .gitignore und wird von gitleaks geprüft.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# Datenschicht
MES_DB_PATH=data/gold/mes.sqlite
CHECKPOINT_DB_PATH=data/checkpoints.sqlite
AUDIT_LOG_PATH=data/audit.jsonl

# Sicherheitsgrenzen
MAX_ROWS_PER_TOOL=200
MAX_TOOL_RESULT_CHARS=8000
CONFIDENCE_THRESHOLD_RECOMMEND=0.70

# Observability (lokal, self-hosted; leer lassen = aus)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
